# Dependencies and build outputs
node_modules/
dist/
target/
src-tauri/gen/

# Local docs, plans, and notes (only README.md ships in the public repo)
Docs/

# Agent and editor state
.claude/
.claude-*
.vscode/
.idea/
.cursor/
.codex/

# Release signing material. The updater private key lives OUTSIDE this repo, in
# %USERPROFILE%\.agentsbar-release\, and is passed to the build through the
# TAURI_SIGNING_PRIVATE_KEY environment variable. These patterns are a second line of
# defence, not the plan: nothing secret should ever be inside the tree to begin with.
*.key
*.pem
*.pfx
.agentsbar-release/
latest.json

# Misc
*.log
.DS_Store
Thumbs.db
